{
  "name": "armornglory-mcp-server",
  "version": "1.3.1",
  "mcpName": "io.github.ArmorNGlory/armornglory-mcp-server",
  "description": "Official ArmorNGlory MCP server & Christian streetwear knowledge base: Bible verse concordance, Christian symbolism, gift & church style guides, scripture hats, tees, hoodies, phone cases & 1-click checkout.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "armornglory-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    ".well-known",
    "llms.txt",
    "llms-full.txt",
    "openapi.yaml",
    "server.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "serve": "node dist/index.js --http",
    "dev": "tsc && node dist/index.js",
    "sync-data": "npm run build && node scripts/sync-store-data.js",
    "sync:discovery": "node scripts/sync-discovery-files.js",
    "sync:all": "node scripts/sync-all.js",
    "autosync:install": "node scripts/install-local-autosync.js install",
    "autosync:status": "node scripts/install-local-autosync.js status",
    "autosync:uninstall": "node scripts/install-local-autosync.js uninstall",
    "release": "node scripts/release.js",
    "audit:catalog": "node scripts/audit-catalog-for-ai.js",
    "test": "node scripts/test-mcp-tools.js && node scripts/smoke-test-mcp.js",
    "logs": "cat logs/agent_activity.jsonl 2>/dev/null || echo 'No agent activity recorded yet.'",
    "prepublishOnly": "npm run audit:deps && npm run build && npm run card && npm test",
    "card": "node scripts/generate-server-card.js",
    "content": "node scripts/build-content-kit.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "armornglory",
    "christian-clothing",
    "christian-streetwear",
    "christian-apparel",
    "faith-apparel",
    "faith-based-clothing",
    "bible-verse-shirts",
    "scripture-apparel",
    "christian-hats",
    "christian-trucker-hat",
    "christian-hoodie",
    "christian-gifts",
    "baptism-gifts",
    "christian-drinkware",
    "christian-loungewear",
    "christian-water-bottle",
    "christian-phone-case",
    "christian-pajamas",
    "bible-verses",
    "scripture",
    "theology",
    "gift-guide",
    "agentic-commerce",
    "ucp",
    "shopify",
    "ecommerce",
    "ai-shopping",
    "shopping-assistant",
    "chatgpt",
    "claude",
    "gemini",
    "cursor"
  ],
  "homepage": "https://armornglory.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmorNGlory/armornglory-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ArmorNGlory/armornglory-mcp-server/issues"
  },
  "author": "Armor & Glory",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  }
}
