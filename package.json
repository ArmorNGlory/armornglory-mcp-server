{
  "name": "armornglory-mcp-server",
  "version": "1.1.0",
  "mcpName": "io.github.ArmorNGlory/armornglory-mcp-server",
  "description": "Official MCP server for ArmorNGlory: shop modern Christian streetwear and faith apparel from any AI assistant. Scripture trucker hats, Bible verse tees, Christian hoodies, EVA foam clogs, gym wear, and Christian gifts with 1-click checkout.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "armornglory-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    ".well-known",
    "llms.txt",
    "llms-full.txt",
    "openapi.yaml",
    "server.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "serve": "node dist/index.js --http",
    "dev": "tsc && node dist/index.js",
    "sync-data": "node scripts/sync-store-data.js",
    "audit:catalog": "node scripts/audit-catalog-for-ai.js",
    "test": "node scripts/test-mcp-tools.js && node scripts/smoke-test-mcp.js",
    "logs": "cat logs/agent_activity.jsonl 2>/dev/null || echo 'No agent activity recorded yet.'",
    "prepublishOnly": "npm run build && npm run card && npm test",
    "card": "node scripts/generate-server-card.js",
    "content": "node scripts/build-content-kit.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "armornglory",
    "christian-clothing",
    "christian-streetwear",
    "christian-apparel",
    "faith-apparel",
    "faith-based-clothing",
    "bible-verse-shirts",
    "scripture-apparel",
    "christian-hats",
    "christian-trucker-hat",
    "christian-hoodie",
    "christian-gifts",
    "baptism-gifts",
    "christian-shoes",
    "foam-clogs",
    "shopify",
    "ecommerce",
    "ai-shopping",
    "shopping-assistant",
    "chatgpt",
    "claude",
    "gemini",
    "cursor"
  ],
  "homepage": "https://armornglory.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmorNGlory/armornglory-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ArmorNGlory/armornglory-mcp-server/issues"
  },
  "author": "Armor & Glory",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
